{
  "scenario": "send_object_instance",
  "description": "LwM2M Send of a whole object instance.",
  "setup": [
    "flownexus start <endpoint> <server>"
  ],
  "steps": [
    {
      "device": [
        "lwm2m send /3303/0"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/flownexus/ingest/resource/timestamped",
          "body": {
            "ep": "<endpoint>",
            "val": [
              {
                "null": {
                  "nodes": {
                    "/3303/0/5602": {
                      "kind": "singleResource",
                      "id": 5602,
                      "type": "FLOAT",
                      "value": "20.0"
                    },
                    "/3303/0/5601": {
                      "kind": "singleResource",
                      "id": 5601,
                      "type": "FLOAT",
                      "value": "20.0"
                    },
                    "/3303/0/5700": {
                      "kind": "singleResource",
                      "id": 5700,
                      "type": "FLOAT",
                      "value": "20.0"
                    },
                    "/3303/0/5604": {
                      "kind": "singleResource",
                      "id": 5604,
                      "type": "FLOAT",
                      "value": "125.0"
                    },
                    "/3303/0/5603": {
                      "kind": "singleResource",
                      "id": 5603,
                      "type": "FLOAT",
                      "value": "-40.0"
                    },
                    "/3303/0/5701": {
                      "kind": "singleResource",
                      "id": 5701,
                      "type": "STRING",
                      "value": "Celsius"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
