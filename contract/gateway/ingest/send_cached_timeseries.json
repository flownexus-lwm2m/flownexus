{
  "scenario": "send_cached_timeseries",
  "description": "LwM2M Send of cached values, each with its own timestamp. Zephyr stores timestamps in seconds, and Leshan rejects two values of one path with the same timestamp, so the writes are more than a second apart.",
  "setup": [
    "flownexus start <endpoint> <server>"
  ],
  "steps": [
    {
      "device": [
        "lwm2m cache /3303/0/5700 4",
        "lwm2m write /3303/0/5700 -f 10.5",
        "sleep 1.1",
        "lwm2m write /3303/0/5700 -f 11.5",
        "sleep 1.1",
        "lwm2m write /3303/0/5700 -f 12.5",
        "lwm2m send /3303/0/5700"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/flownexus/ingest/resource/timestamped",
          "body": {
            "ep": "<endpoint>",
            "val": [
              {
                "<timestamp>": {
                  "nodes": {
                    "/3303/0/5700": {
                      "kind": "singleResource",
                      "id": 5700,
                      "type": "FLOAT",
                      "value": "10.5"
                    }
                  }
                }
              },
              {
                "<timestamp>": {
                  "nodes": {
                    "/3303/0/5700": {
                      "kind": "singleResource",
                      "id": 5700,
                      "type": "FLOAT",
                      "value": "11.5"
                    }
                  }
                }
              },
              {
                "<timestamp>": {
                  "nodes": {
                    "/3303/0/5700": {
                      "kind": "singleResource",
                      "id": 5700,
                      "type": "FLOAT",
                      "value": "12.5"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
