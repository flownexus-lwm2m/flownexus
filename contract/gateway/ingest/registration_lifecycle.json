{
  "scenario": "registration_lifecycle",
  "description": "Register, update the registration, and deregister.",
  "setup": [],
  "steps": [
    {
      "device": [
        "flownexus start <endpoint> <server>"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/flownexus/ingest/registration",
          "body": {
            "ep": "<endpoint>",
            "event": "registered",
            "time": "<timestamp>"
          }
        }
      ]
    },
    {
      "device": [
        "lwm2m update"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/flownexus/ingest/registration",
          "body": {
            "ep": "<endpoint>",
            "event": "updated",
            "time": "<timestamp>"
          }
        }
      ]
    },
    {
      "device": [
        "lwm2m stop"
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/flownexus/ingest/registration",
          "body": {
            "ep": "<endpoint>",
            "event": "unregistered",
            "time": "<timestamp>"
          }
        }
      ]
    }
  ]
}
