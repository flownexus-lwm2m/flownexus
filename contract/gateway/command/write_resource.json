{
  "scenario": "write_resource",
  "description": "Write of a single resource that the device accepts.",
  "setup": [
    "flownexus start <endpoint> <server>"
  ],
  "steps": [
    {
      "device": [
        "http PUT /api/clients/<endpoint>/3/0/14?timeout=5&format=CBOR {\"id\": 14, \"kind\": \"singleResource\", \"value\": \"+02:00\", \"type\": \"STRING\"}"
      ],
      "requests": [],
      "responses": [
        {
          "status": 200,
          "body": {
            "status": "CHANGED",
            "code": "2.04"
          }
        }
      ]
    }
  ]
}
