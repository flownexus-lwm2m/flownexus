mainmenu "Flownexus LwM2M Client"

config LWM2M_APP_ID
	string "LwM2M endpoint name"
	default "flownexus-client"
	help
	  Endpoint name used by autostart and as DTLS PSK identity.

config LWM2M_APP_SERVER
	string "LwM2M server URI"
	default "coaps://127.0.0.1:5684" if LWM2M_DTLS_SUPPORT
	default "coap://127.0.0.1:5683"
	help
	  Initial Security object server URI (0/0/0). "flownexus start"
	  can override it at runtime.

config LWM2M_APP_AUTOSTART
	bool "Start the RD client at boot"
	help
	  Register with CONFIG_LWM2M_APP_ID at boot. When disabled, start the
	  client with "flownexus start [endpoint]".

if LWM2M_DTLS_SUPPORT

config LWM2M_APP_PSK
	string "PSK as hex string"
	default "000102030405060708090a0b0c0d0e0f"

config LWM2M_APP_TLS_TAG
	int "TLS security tag"
	default 1

endif

source "Kconfig.zephyr"
