FROM docker.io/library/maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B package

FROM docker.io/library/eclipse-temurin:21-jre@sha256:227118764cccd3c3294617061aaa93a08309c63a395eefa83e6b35032992ea99
ARG REVISION=unknown
LABEL org.opencontainers.image.title="flownexus-leshan" \
      org.opencontainers.image.description="flownexus Leshan LwM2M gateway" \
      org.opencontainers.image.source="https://github.com/flownexus-lwm2m/flownexus" \
      org.opencontainers.image.revision="${REVISION}"
RUN useradd --system --uid 10001 --no-create-home leshan
COPY --from=build /build/target/leshan-svr.jar /app/leshan-svr.jar
USER leshan
EXPOSE 5683/udp 8080
ENTRYPOINT ["java", "-jar", "/app/leshan-svr.jar"]
