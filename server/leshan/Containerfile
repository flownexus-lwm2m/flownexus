FROM docker.io/library/maven:3.9-eclipse-temurin-25@sha256:93b8a14ea2f412782e4e842651273b4d903e35cc496284f178fbbe2d67d00976 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B package

FROM docker.io/library/eclipse-temurin:25-jre@sha256:dbb43d81099eec91e0800226ed2296d03146ee7857165b95112372ad0d67e87f
ARG REVISION=unknown
LABEL org.opencontainers.image.title="flownexus-leshan" \
      org.opencontainers.image.description="flownexus Leshan LwM2M gateway" \
      org.opencontainers.image.source="https://github.com/flownexus-lwm2m/flownexus" \
      org.opencontainers.image.revision="${REVISION}"
RUN useradd --system --uid 10001 --no-create-home leshan
COPY --from=build /build/target/leshan-svr.jar /app/leshan-svr.jar
USER leshan
EXPOSE 5683/udp 8080
ENTRYPOINT ["java", "-jar", "/app/leshan-svr.jar"]
