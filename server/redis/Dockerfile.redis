FROM docker.io/library/redis:8.10-alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0

ARG REVISION=unknown
LABEL org.opencontainers.image.title="flownexus-redis" \
      org.opencontainers.image.description="flownexus Celery broker" \
      org.opencontainers.image.source="https://github.com/flownexus-lwm2m/flownexus" \
      org.opencontainers.image.revision="${REVISION}"

COPY redis.conf /usr/local/etc/redis/redis.conf

# The base entrypoint drops to the redis user for redis-server
CMD ["redis-server", "/usr/local/etc/redis/redis.conf"]
