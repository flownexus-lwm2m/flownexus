{{ ansible_managed | comment }}
DJANGO_SETTINGS_MODULE=core.settings
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS={{ flownexus_dashboard_host }},localhost,127.0.0.1,flownexus-django
DJANGO_CSRF_ORIGINS=https://{{ flownexus_dashboard_host }}
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_WORKERS={{ flownexus_django_workers }}
MEDIA_ROOT=/var/www/flownexus/binaries
MEDIA_URL=/binaries/
LESHAN_URI=http://flownexus-leshan:8080
CELERY_BROKER_URL=redis://flownexus-redis:6379/0
CELERY_RESULT_BACKEND=redis://flownexus-redis:6379/0
C_FORCE_ROOT=true
