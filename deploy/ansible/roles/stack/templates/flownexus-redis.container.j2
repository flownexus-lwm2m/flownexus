{{ ansible_managed | comment }}
[Unit]
Description=flownexus Redis (Celery broker)
After=network-online.target

[Container]
ContainerName=flownexus-redis
Image={{ stack_images.redis }}
Network=podman-flownexus-network
HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
