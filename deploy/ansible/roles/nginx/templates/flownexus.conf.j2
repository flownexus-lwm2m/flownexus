{{ ansible_managed | comment }}
# Serves:
#   {{ flownexus_dashboard_host }} - Django dashboard (reverse proxy to uvicorn)
#   {{ flownexus_fw_host }} - Firmware binaries (IoT-safe TLS, no HTTP/2)
{% if flownexus_landing_host %}
#   {{ flownexus_landing_host }} - Landing page (static HTML)
{% endif %}
{% if flownexus_docs_host %}
#   {{ flownexus_docs_host }} - Documentation (Sphinx HTML)
{% endif %}
#
# nginx handles HTTP/HTTPS only; LwM2M CoAP (5683/udp) goes directly to Leshan.

{% if flownexus_landing_host %}
# --------------------------------------------------------------------------
# {{ flownexus_landing_host }} — Landing page
# --------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ flownexus_landing_host }};

    ssl_certificate     {{ flownexus_tls_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ flownexus_tls_cert_dir }}/privkey.pem;

    root {{ flownexus_web_root }}/landing;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    server_tokens off;

    # Block hidden/dot files
    location ~ /\. {
        return 404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    access_log /var/log/nginx/{{ flownexus_landing_host }}-access.log;
    error_log  /var/log/nginx/{{ flownexus_landing_host }}-error.log;
}
{% endif %}

{% if flownexus_docs_host %}
# --------------------------------------------------------------------------
# {{ flownexus_docs_host }} — Sphinx documentation
# --------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ flownexus_docs_host }};

    ssl_certificate     {{ flownexus_tls_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ flownexus_tls_cert_dir }}/privkey.pem;

    root {{ flownexus_web_root }}/docs;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    server_tokens off;

    # Block hidden/dot files
    location ~ /\. {
        return 404;
    }

    # Sphinx HTML fallback: try exact path, then .html, then directory index
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    access_log /var/log/nginx/{{ flownexus_docs_host }}-access.log;
    error_log  /var/log/nginx/{{ flownexus_docs_host }}-error.log;
}
{% endif %}

# --------------------------------------------------------------------------
# {{ flownexus_fw_host }} — Firmware download server (IoT-safe TLS)
# --------------------------------------------------------------------------
#
# This server block is specifically configured for constrained IoT devices
# such as the Nordic nRF9160 whose modem TLS engine has a limited receive
# buffer (max 2048 bytes for TLS records).
#
# Key settings:
#   ssl_buffer_size 1370  — Keeps TLS records within a single TCP segment
#                           (1500 MTU - 20 IP - 20 TCP - TLS overhead).
#                           The nRF9160 modem rejects records larger than
#                           its internal buffer with NRF_EMSGSIZE (errno 122).
#   No HTTP/2             — HTTP/2 framing adds overhead that can push TLS
#                           records above the device buffer limit.
#   No gzip               — Firmware binaries are not compressible; gzip
#                           would only add overhead and complexity.
#
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ flownexus_fw_host }};

    ssl_certificate     {{ flownexus_fw_ssl_certificate }};
    ssl_certificate_key {{ flownexus_fw_ssl_certificate_key }};
    ssl_buffer_size 1370;

    root {{ flownexus_web_root }};

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Download-Options "noopen" always;
    server_tokens off;

    # Block hidden/dot files
    location ~ /\. {
        return 404;
    }

    # Serve only concrete files — no directory listings, no index pages
    location / {
        try_files $uri =404;
    }

    access_log /var/log/nginx/{{ flownexus_fw_host }}-access.log;
    error_log  /var/log/nginx/{{ flownexus_fw_host }}-error.log;
}

# --------------------------------------------------------------------------
# {{ flownexus_dashboard_host }} — Django application (reverse proxy)
# --------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ flownexus_dashboard_host }};

    ssl_certificate     {{ flownexus_tls_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ flownexus_tls_cert_dir }}/privkey.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://rsms.me; img-src 'self' data: blob: https:; font-src 'self' https://rsms.me; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    server_tokens off;

    # Block hidden/dot files
    location ~ /\. {
        return 404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    access_log /var/log/nginx/{{ flownexus_dashboard_host }}-access.log;
    error_log  /var/log/nginx/{{ flownexus_dashboard_host }}-error.log;
}

# --------------------------------------------------------------------------
# HTTP → HTTPS redirects (certbot typically adds these automatically)
# --------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name {{ flownexus_hosts | join(' ') }};
    return 301 https://$host$request_uri;
}

# --------------------------------------------------------------------------
# localhost — Health check / internal access (plain HTTP, no TLS)
# --------------------------------------------------------------------------
server {
    listen 127.0.0.1:80;
    server_name localhost;

    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}

# --------------------------------------------------------------------------
# WebSocket upgrade map (required for proxy_set_header Connection)
# --------------------------------------------------------------------------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
