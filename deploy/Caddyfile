# Flownexus Caddy Configuration
# This file should be placed at /etc/caddy/Caddyfile on the server.
#
# IMPORTANT: Caddy handles HTTP/HTTPS traffic only.
# UDP traffic for LwM2M (CoAP) is handled separately in server/compose.yml.

{
    email webmaster@flownexus.org
}

flownexus.org {
    root * /var/www/flownexus/landing
    file_server

    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        -Server
    }

    @hidden {
        path */.*
    }
    respond @hidden 404

    encode gzip zstd

    log {
        output file /var/log/caddy/flownexus.org-access.log
        format json
    }
}

docs.flownexus.org {
    root * /var/www/flownexus/docs
    file_server

    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @hidden {
        path */.*
    }
    respond @hidden 404

    encode gzip zstd
    try_files {path} {path}.html {path}/index.html =404

    log {
        output file /var/log/caddy/docs.flownexus.org-access.log
        format json
    }
}

fw.flownexus.org {
    root * /var/www/flownexus
    # No browse — directory listings are disabled.
    # Files are served only via direct paths: /binaries/<filename>
    file_server

    # Block hidden files and dotfiles
    @hidden {
        path */.*
    }
    respond @hidden 404

    # Block root and any directory path — only concrete file paths are valid
    @not_a_file {
        not file
    }
    respond @not_a_file 404

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-Download-Options "noopen"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/fw.flownexus.org-access.log
        format json
    }
}

dashboard.flownexus.org {
    reverse_proxy localhost:8000 {
        health_uri /admin/login/
        health_interval 30s
        health_timeout 5s

        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://rsms.me; img-src 'self' data: blob: https:; font-src 'self' https://rsms.me; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    @hidden {
        path */.*
    }
    respond @hidden 404

    encode gzip zstd

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket localhost:8000

    log {
        output file /var/log/caddy/dashboard.flownexus.org-access.log
        format json
    }
}

http://localhost, http://127.0.0.1 {
    reverse_proxy localhost:8000 {
        health_uri /admin/login/
        health_interval 30s
        health_timeout 5s

        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    encode gzip zstd
}
