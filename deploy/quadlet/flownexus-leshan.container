#
# Flownexus Leshan LwM2M Server
# Rootless Quadlet container definition
#

[Unit]
Description=Flownexus Leshan LwM2M Server
After=network-online.target

[Container]
ContainerName=flownexus-leshan
Image=localhost/flownexus-leshan:latest
Network=podman-flownexus-network
PublishPort=0.0.0.0:5683:5683/udp
PublishPort=127.0.0.1:8080:8080
Environment=DATA_SENDER_URI=http://flownexus-django:8000
HealthCmd=curl -fsS http://localhost:8080/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
