set -eu

usage() {
    cat <<'EOF'
Usage: deploy-flownexus [options]

Deploy Flownexus using systemd Quadlet containers (rootless Podman).

Optional:
  --local-test      Run containers locally using podman-compose (for testing)
  --setup-only      Only create directories and reload caddy, skip container deployment
  --deploy-user     User that owns the repository and runs containers (default: flownexus)
  --app-root        Repository root (default: script parent directory)
  --web-root        Web root (default: /var/www/flownexus)
  --db-path         SQLite database directory (default: <app-root>/server/data)
  --firmware-path   Firmware download directory (default: /var/www/flownexus/binaries)
  --caddyfile       Path to the Caddyfile (default: <app-root>/deploy/Caddyfile)
  --caddyfile-target Final Caddyfile path (default: /etc/caddy/Caddyfile)
  --health-url      Local health check URL (default: http://127.0.0.1:8000/admin/login/)
  -h, --help        Show this help message

Examples:
  # Deploy to production (default)
  sudo deploy-flownexus

  # Local testing with podman-compose
  deploy-flownexus --local-test

  # Setup only (directories + caddy)
  sudo deploy-flownexus --setup-only
EOF
}

deploy_user="flownexus"
app_root="/home/flownexus/flownexus"
web_root="/var/www/flownexus"
db_path=""
firmware_path="/var/www/flownexus/binaries"
caddyfile_target="/etc/caddy/Caddyfile"
health_url="http://127.0.0.1:8000/admin/login/"
caddyfile_source="/home/flownexus/flownexus/deploy/Caddyfile"
setup_only=0
local_test=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --local-test)
            local_test=1
            shift
            ;;
        --setup-only)
            setup_only=1
            shift
            ;;
        --caddyfile)
            caddyfile_source="${2:-}"
            shift 2
            ;;
        --deploy-user)
            deploy_user="${2:-}"
            shift 2
            ;;
        --app-root)
            app_root="${2:-}"
            shift 2
            ;;
        --web-root)
            web_root="${2:-}"
            shift 2
            ;;
        --db-path)
            db_path="${2:-}"
            shift 2
            ;;
        --firmware-path)
            firmware_path="${2:-}"
            shift 2
            ;;
        --caddyfile-target)
            caddyfile_target="${2:-}"
            shift 2
            ;;
        --health-url)
            health_url="${2:-}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf '%s\n' "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -z "$caddyfile_source" ]; then
    usage >&2
    exit 2
fi

APP_VERSION=$(cd "$app_root" && git describe --tags 2>/dev/null || echo "dev")

if [ "$local_test" -eq 1 ]; then
    # Local testing mode - use podman-compose
    if [ -z "$db_path" ]; then
        db_path="$app_root/server/data"
    fi
    
    printf '%s\n' "Running in local test mode with podman-compose..."
    cd "$app_root"
    APP_VERSION="$APP_VERSION" \
    DJANGO_DB_HOST_PATH="$db_path" \
    FIRMWARE_STORAGE_HOST_PATH="$firmware_path" \
    podman-compose -f server/compose.yml up -d --build
    
    printf '%s\n' "Local test deployment complete."
    printf '%s\n' "View logs: podman logs -f flownexus-django"
    exit 0
fi

# Production mode - require root for systemd/caddy operations
if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "deploy-flownexus must run as root via sudo for production deployment" >&2
    exit 1
fi

if [ -z "$db_path" ]; then
    db_path="$app_root/server/data"
fi

# ==========================================
# 1. SETUP DIRECTORIES AND PERMISSIONS
# ==========================================

install -d -o "$deploy_user" -g caddy -m 2775 "$web_root"
install -d -o "$deploy_user" -g caddy -m 2775 "$web_root/landing"
install -d -o "$deploy_user" -g caddy -m 2775 "$web_root/docs"
install -d -o "$deploy_user" -g caddy -m 2775 "$firmware_path"
install -d -o "$deploy_user" -g "$deploy_user" -m 2775 "$db_path"
install -d -o "$deploy_user" -g "$deploy_user" -m 2775 "/home/$deploy_user/backups"

# ==========================================
# 2. CONFIGURE CADDY
# ==========================================

caddy validate --config "$caddyfile_source"
install -m 0644 "$caddyfile_source" "$caddyfile_target"
systemctl reload caddy || systemctl restart caddy

if [ "$setup_only" -eq 1 ]; then
    printf '%s\n' "Setup complete: directories created and caddy reloaded"
    exit 0
fi

# ==========================================
# 3. ENABLE LINGER FOR ROOTLESS CONTAINERS
# ==========================================

if ! loginctl show-user "$deploy_user" --property=Linger --value | grep -q "yes"; then
    printf '%s\n' "Enabling linger for $deploy_user (required for rootless containers to persist after logout)..."
    loginctl enable-linger "$deploy_user"
fi

# ==========================================
# 4. GENERATE DJANGO SECRET KEY (if missing)
# ==========================================

secret_env="/home/$deploy_user/.config/flownexus/env"
if [ ! -f "$secret_env" ]; then
    printf '%s\n' "Generating Django secret key..."
    install -d -o "$deploy_user" -g "$deploy_user" -m 0700 "/home/$deploy_user/.config/flownexus"
    secret_key=$(python3 -c "import secrets; print(secrets.token_urlsafe(50))")
    printf 'DJANGO_SECRET_KEY=%s\n' "$secret_key" > "$secret_env"
    chown "$deploy_user:$deploy_user" "$secret_env"
    chmod 0600 "$secret_env"
else
    printf '%s\n' "Django secret key already exists at $secret_env"
fi

# ==========================================
# 5. BACKUP DATABASE
# ==========================================

db_file="$db_path/db.sqlite3"
if [ -f "$db_file" ]; then
    backup_dir="/home/$deploy_user/backups"
    backup_file="db_$(date +%Y-%m-%d_%H-%M-%S).sqlite3"
    printf '%s\n' "Backing up database to $backup_dir/$backup_file..."
    install -d -o "$deploy_user" -g "$deploy_user" -m 2775 "$backup_dir"
    cp "$db_file" "$backup_dir/$backup_file"
    chown "$deploy_user:$deploy_user" "$backup_dir/$backup_file"
fi

# ==========================================
# 6. DEPLOY CONTAINERS VIA SYSTEMD QUADLET
# ==========================================

printf '%s\n' "Deploying containers via systemd Quadlet..."

# Get the user's UID for XDG_RUNTIME_DIR
user_uid=$(id -u "$deploy_user")

# Create the deployment script for the user
deploy_script=$(cat << INNEREOF
#!/bin/sh
set -e

# Ensure podman socket is running
systemctl --user start podman.socket 2>/dev/null || true

# Install quadlet files
mkdir -p ~/.config/containers/systemd
rm -f ~/.config/containers/systemd/flownexus-*.volume ~/.config/containers/systemd/flownexus.network
cp "$app_root/deploy/quadlet/"*.container ~/.config/containers/systemd/

# Reload systemd to pick up new quadlet files
systemctl --user daemon-reload

# Ensure the shared network exists
podman network exists podman-flownexus-network || podman network create podman-flownexus-network

# Stop existing containers gracefully
systemctl --user stop podman-compose@server.service 2>/dev/null || true
systemctl --user disable podman-compose@server.service 2>/dev/null || true
systemctl --user stop flownexus-django.service 2>/dev/null || true
systemctl --user stop flownexus-leshan.service 2>/dev/null || true
systemctl --user stop flownexus-redis.service 2>/dev/null || true
podman stop -t 30 flownexus-django 2>/dev/null || true
podman stop -t 30 flownexus-leshan 2>/dev/null || true
podman stop -t 10 flownexus-redis 2>/dev/null || true
podman rm -f flownexus-django flownexus-leshan flownexus-redis 2>/dev/null || true
sleep 2

# Build images using podman-compose (reuses existing build logic)
cd "$app_root"
APP_VERSION="$APP_VERSION" podman-compose -f "$app_root/server/compose.yml" build

# Start containers via systemd
systemctl --user start flownexus-redis.service
systemctl --user start flownexus-leshan.service
systemctl --user start flownexus-django.service
INNEREOF
)

# Run deployment as the deploy user
runuser -u "$deploy_user" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
    sh -c "$deploy_script"

# ==========================================
# 7. VERIFY DEPLOYMENT
# ==========================================

printf '%s\n' "Waiting for services to start..."
sleep 10

max_retries=60
retry_delay=5
retry_count=0
health_ok=0

while [ "$retry_count" -lt "$max_retries" ]; do
    if curl -fsS "$health_url" > /dev/null 2>&1; then
        health_ok=1
        break
    fi
    retry_count=$((retry_count + 1))
    if [ "$retry_count" -lt "$max_retries" ]; then
        printf '  Attempt %d/%d failed, retrying in %d seconds...\n' "$retry_count" "$max_retries" "$retry_delay"
        sleep "$retry_delay"
    fi
done

if [ "$health_ok" -eq 0 ]; then
    printf '%s\n' "ERROR: Health check failed after $max_retries attempts" >&2
    printf '%s\n' "Check service status:" >&2
    runuser -u "$deploy_user" -- env \
        XDG_RUNTIME_DIR="/run/user/$user_uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
        systemctl --user status flownexus-redis.service --no-pager || true
    runuser -u "$deploy_user" -- env \
        XDG_RUNTIME_DIR="/run/user/$user_uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
        systemctl --user status flownexus-leshan.service --no-pager || true
    runuser -u "$deploy_user" -- env \
        XDG_RUNTIME_DIR="/run/user/$user_uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
        systemctl --user status flownexus-django.service --no-pager || true
    exit 1
fi

printf '%s\n' ""
printf '%s\n' "=========================================="
printf '%s\n' "Deployment successful!"
printf '%s\n' "=========================================="
printf '%s\n' ""
printf '%s\n' "Service Status:"
runuser -u "$deploy_user" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
    systemctl --user is-active flownexus-redis.service
runuser -u "$deploy_user" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
    systemctl --user is-active flownexus-leshan.service
runuser -u "$deploy_user" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_uid/bus" \
    systemctl --user is-active flownexus-django.service
printf '%s\n' ""
printf '%s\n' "View logs with:"
printf '%s\n' "  journalctl --user -u flownexus-django -f"
printf '%s\n' "  journalctl --user -u flownexus-redis -f"
printf '%s\n' "  journalctl --user -u flownexus-leshan -f"
